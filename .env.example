# =============================================================================
# XenoTrack Colony Register — Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git.
# =============================================================================

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Email (Resend) ---
# Sign up at https://resend.com and get an API key
RESEND_API_KEY=
DEFAULT_FROM_EMAIL=noreply@yourlab.example.com

# --- Email (Postmark) — alternative to Resend ---
# POSTMARK_API_KEY=

# --- SMS (Twilio) ---
# Sign up at https://twilio.com for SID, token, and phone number
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- App ---
APP_BASE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
